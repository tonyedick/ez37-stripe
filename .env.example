# EZ37 Payments — configuration variable NAMES ONLY.
#
# Copy to .env for local development (.env is git-ignored) or, preferably,
# define these as PHP constants in wp-config.php on staging/production.
# Constants take precedence over environment variables.
#
# NEVER commit real values. NEVER put live keys on a development machine.

# "test" or "live". Anything else is treated as "test" and reported as an error.
EZ37_STRIPE_MODE=test

# Stripe sandbox (test mode) credentials — development and staging.
# Secret key may be a standard key (sk_test_...) or, preferably, a restricted key (rk_test_...).
EZ37_STRIPE_TEST_SECRET_KEY=
# Webhook signing secret (whsec_...). Locally, `stripe listen` prints one.
EZ37_STRIPE_TEST_WEBHOOK_SECRET=

# Stripe live credentials — PRODUCTION ONLY. Leave empty everywhere else.
EZ37_STRIPE_LIVE_SECRET_KEY=
EZ37_STRIPE_LIVE_WEBHOOK_SECRET=

# Master switch for accepting new checkouts. Defaults to off.
# Set to 1 only once configuration is complete and tested.
EZ37_PAYMENTS_CHECKOUT_ENABLED=0

# Minimum log level: debug, info, warning, error. Defaults to info.
EZ37_PAYMENTS_LOG_LEVEL=info

# Recipient of internal "new sale" notifications (used from Phase 7).
EZ37_PAYMENTS_ADMIN_EMAIL=
