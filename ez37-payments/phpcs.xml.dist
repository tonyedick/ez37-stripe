<?xml version="1.0"?>
<ruleset name="EZ37 Payments">
	<description>WordPress Coding Standards for EZ37 Payments.</description>

	<file>./ez37-payments.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./tests</file>
	<file>./config</file>
	<file>./templates</file>

	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PSR-4 autoloading: file names match class names (src/Config.php),
		     not WordPress's class-config.php convention. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ez37-payments"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ez37_payments"/>
				<element value="EZ37_PAYMENTS"/>
				<element value="EZ37\Payments"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Exception messages in this plugin are never printed to visitors: customers see
	     fixed, escaped messages (CheckoutShortcode::error_message) and details go only to
	     the redacting Logger. Escaping log text with esc_html() would only corrupt the logs. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>/src/*</exclude-pattern>
	</rule>

	<!-- False positives: PHPCompatibility 9.x does not understand PHP 8.1 enums,
	     so $this/self inside enum methods are reported as outside a class. -->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
		<exclude-pattern>/src/Transactions/*Status\.php</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibility.FunctionDeclarations.NewParamTypeDeclarations.SelfOutsideClassScopeFound">
		<exclude-pattern>/src/Transactions/*Status\.php</exclude-pattern>
	</rule>

	<!-- Tests use PHPUnit's camelCase API and do not need doc comments on every method. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
